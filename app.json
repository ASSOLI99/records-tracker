{
  "expo": {
    "name": "Records Tracker",
    "slug": "records-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "records-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assoliindustries.recordstracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.assoliindustries.recordstracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Records Tracker lets you attach photos and videos to your journey steps.",
          "cameraPermission": "Records Tracker lets you take progress photos for your journey steps.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4f6bff"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Cairo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/cairo_regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/cairo_medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/cairo_semibold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/cairo_bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/cairo_extrabold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/cairo_black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/cairo_regular.ttf",
              "./assets/fonts/cairo_medium.ttf",
              "./assets/fonts/cairo_semibold.ttf",
              "./assets/fonts/cairo_bold.ttf",
              "./assets/fonts/cairo_extrabold.ttf",
              "./assets/fonts/cairo_black.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
